# ============================================
# MindfulSpend AI - .gitignore
# ============================================

# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
build/
dist/
*.egg

# === Virtual Environments ===
.venv/
venv/
env/
ENV/

# === Environment & Secrets ===
.env
.env.local
.env.*.local
*.pem
*.key
secrets/

# === Jupyter ===
.ipynb_checkpoints/
*.ipynb_checkpoints

# === ML Artifacts (large) ===
backend/data/01_raw/*.csv
backend/data/01_raw/*.json
backend/data/01_raw/*.parquet
backend/data/02_interim/*.csv
backend/data/02_interim/*.parquet
backend/data/03_processed/*.csv
backend/data/03_processed/*.parquet
!backend/data/01_raw/.gitkeep
!backend/data/02_interim/.gitkeep
!backend/data/03_processed/.gitkeep

# === Trained Models (large binaries) ===
*.pkl
*.h5
*.onnx

# === Database ===
*.db
*.sqlite
*.sqlite3
mindfulspend.db*

# === Node / Frontend ===
node_modules/
.next/
dist/
build/
.vite/
*.tsbuildinfo

# === Editor / OS ===
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# === Logs ===
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# === Coverage ===
.coverage
htmlcov/
.pytest_cache/
coverage/

# === Misc ===
.mypy_cache/
.ruff_cache/
backend/data/01_raw/*.xlsx
